{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "types": ["node"], "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["vite.config.ts", "src/shared/**/*", "test/**/*"]
}
