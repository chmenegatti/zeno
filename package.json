{
  "name": "zeno",
  "version": "1.2.0",
  "private": true,
  "description": "Cliente de API desktop sem abas, em Go: coleções em YAML, segredos criptografados e import do Insomnia",
  "keywords": [
    "api-client",
    "http-client",
    "rest",
    "insomnia",
    "yaak",
    "postman-alternative",
    "yaml",
    "desktop",
    "go",
    "wails"
  ],
  "license": "MIT",
  "author": "Cesar Menegatti",
  "homepage": "https://github.com/chmenegatti/zeno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chmenegatti/zeno.git"
  },
  "bugs": {
    "url": "https://github.com/chmenegatti/zeno/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "cd wails && make run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "cm6-graphql": "^1.0.0",
    "graphql": "^16.15.0",
    "httpsnippet": "^3.0.10"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "commit-and-tag-version": "^13.3.0",
    "mime-db": "1.52.0",
    "querystring-es3": "^0.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "url": "^0.11.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
