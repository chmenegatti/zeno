{
  "name": "zeno",
  "version": "0.1.0",
  "description": "Cliente de API desktop, sem abas",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "Cesar Menegatti",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview --noSandbox",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --linux deb AppImage"
  },
  "build": {
    "appId": "dev.zeno.app",
    "productName": "Zeno",
    "files": [
      "out/**/*"
    ],
    "linux": {
      "category": "Development",
      "target": [
        "deb",
        "AppImage"
      ],
      "maintainer": "Cesar Menegatti <zeno@localhost>"
    }
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "undici": "^8.12.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "zustand": "^5.1.0"
  },
  "homepage": "http://localhost/zeno"
}
