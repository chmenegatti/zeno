{
  "workspaces": [
    {
      "id": "wrk_33d0a2c57aee546bd64706ff",
      "name": "Loja Postman",
      "settings": {
        "insecureTLS": false,
        "timeoutMs": 30000
      },
      "environments": [
        {
          "id": "env_9818adba406c30d2c9ff410b",
          "name": "Base",
          "parentId": null,
          "data": {
            "baseUrl": "https://loja.test",
            "id": "p-1"
          },
          "sortKey": 0
        },
        {
          "id": "env_e06d7e152735c83779ea8583",
          "name": "Produção",
          "parentId": "env_9818adba406c30d2c9ff410b",
          "data": {
            "baseUrl": "https://prod.loja.test",
            "token": ""
          },
          "sortKey": 1
        }
      ],
      "children": [
        {
          "kind": "folder",
          "id": "fld_10d229478b9d7265e60b90e4",
          "name": "Produtos",
          "sortKey": 0,
          "headers": [],
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "vars": {},
          "scripts": {
            "pre": "console.log(1)"
          },
          "children": [
            {
              "kind": "request",
              "id": "req_eb0a08c0b9b79f2657ffb641",
              "name": "Obter produto",
              "method": "GET",
              "url": "{{baseUrl}}/produtos/{{ id }}",
              "params": [
                {
                  "name": "campos",
                  "value": "nome",
                  "enabled": true
                },
                {
                  "name": "x",
                  "value": "{{$randomInt}}",
                  "enabled": true
                }
              ],
              "headers": [
                {
                  "name": "X-Req",
                  "value": "{% uuid 'v4' %}",
                  "enabled": true
                },
                {
                  "name": "X-Off",
                  "value": "1",
                  "enabled": false
                }
              ],
              "body": {
                "mime": null
              },
              "auth": {
                "type": "inherit"
              },
              "sortKey": 0
            },
            {
              "kind": "request",
              "id": "req_8d2d29dba12ee6649a218fca",
              "name": "Criar produto",
              "method": "POST",
              "url": "{{baseUrl}}/produtos",
              "params": [],
              "headers": [],
              "body": {
                "mime": "application/json",
                "text": "{\"nome\":\"Caneta\"}"
              },
              "auth": {
                "type": "basic",
                "username": "ana",
                "password": "{{senha}}"
              },
              "sortKey": 1
            }
          ]
        },
        {
          "kind": "request",
          "id": "req_78acf9861cff0c5e6632f518",
          "name": "Upload",
          "method": "POST",
          "url": "{{baseUrl}}/upload",
          "params": [],
          "headers": [],
          "body": {
            "mime": "multipart/form-data",
            "fields": [
              {
                "name": "nome",
                "value": "a",
                "enabled": true
              },
              {
                "name": "arq",
                "value": "",
                "enabled": true,
                "file": "/tmp/a.png"
              }
            ]
          },
          "auth": {
            "type": "none"
          },
          "scripts": {
            "pre": "console.log(1)"
          },
          "sortKey": 1
        },
        {
          "kind": "request",
          "id": "req_2f1b1d15e5926571815744ca",
          "name": "Produtos GraphQL",
          "method": "POST",
          "url": "{{baseUrl}}/graphql",
          "params": [],
          "headers": [],
          "body": {
            "mime": "application/graphql",
            "text": "{\n  \"query\": \"query P($id: ID!) { produto(id: $id) { nome } }\",\n  \"variables\": {\n    \"id\": \"p-1\"\n  }\n}"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "scripts": {
            "pre": "console.log(1)"
          },
          "sortKey": 2
        },
        {
          "kind": "request",
          "id": "req_5e3e02dd0d0b77385eeb3c95",
          "name": "Login OAuth",
          "method": "POST",
          "url": "{{baseUrl}}/oauth",
          "params": [],
          "headers": [],
          "body": {
            "mime": null
          },
          "auth": {
            "type": "oauth2",
            "grantType": "authorization_code"
          },
          "scripts": {
            "pre": "console.log(1)"
          },
          "sortKey": 3
        }
      ]
    }
  ],
  "warnings": [
